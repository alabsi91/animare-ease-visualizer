{
  "type": "module",
  "dependencies": {
    "@staticview/ui": "^1.0.0-beta.3",
    "animare": "^2.0.0-beta.1.0.3",
    "highlight.js": "^11.12.0"
  },
  "scripts": {
    "dev": "staticbolt dev",
    "build": "staticbolt build",
    "serve": "staticbolt serve",
    "generate-types": "sv types --include \"sources/graph-editor/*.ts\" --frameworks dom,global --outdir sources/graph-editor/types --flat",
    "generate-docs": "sv docs --include \"sources/graph-editor/*.ts\" --md-out sources/graph-editor --md-name README.md --no-manifest --no-web-types --html-data-out sources/graph-editor/graph-editor.html-data.json",
    "fix-eslint": "eslint --fix",
    "fix-stylelint": "stylelint \"./sources/**/*.{css,html}\" \"./pages/**/*.html\" --fix",
    "fix-all": "npm run fix-eslint && npm run fix-stylelint"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "not op_mini all"
  ],
  "devDependencies": {
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@html-eslint/eslint-plugin": "^0.65.0",
    "@html-eslint/parser": "^0.65.0",
    "@staticbolt/core": "beta",
    "@staticbolt/lsp": "beta",
    "@staticview/cli": "^1.0.0-beta.3",
    "@staticview/eslint-plugin": "^1.0.0-beta.3",
    "@staticview/staticbolt-plugin": "^1.0.0-beta.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "postcss": "^8.5.28",
    "postcss-html": "^2.0.0",
    "postcss-preset-env": "^11.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-jinja-template": "^2.2.0",
    "prettier-plugin-jsdoc": "^1.8.1",
    "stylelint": "^17.15.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-no-unsupported-browser-features": "^8.1.2",
    "stylelint-use-logical": "^2.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }

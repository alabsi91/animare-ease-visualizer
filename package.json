    "eslint-plugin-prettier": "^5.5.0",
    "globals": "^16.2.0",
    "postcss": "^8.5.6",
    "postcss-html": "^1.8.0",
    "postcss-import": "^16.1.1",
    "postcss-preset-env": "^10.2.3",
    "postcss-svgo": "^7.0.2",
    "prettier": "3.5.3",

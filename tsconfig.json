{
  "compilerOptions": {
    "paths": {
      "~/*": ["./pages/*"],
      "@/*": ["./sources/*"],
      "@assets/*": ["./sources/assets/*"],
      "@styles/*": ["./sources/styles/*"],
      "@layouts/*": ["./sources/layouts/*"],
      "@graph-editor/*": ["./sources/graph-editor/*"],
      "@parts/*": ["./sources/parts/*"],
      "@scripts/*": ["./sources/scripts/*"],
      "@types": ["./sources/types"]
    },
    "lib": ["dom", "dom.iterable", "esnext"],

    "strict": true,
    "alwaysStrict": true,
    "target": "ES2022",
    "module": "Preserve",
    "noEmit": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true
  },
  "include": ["sources", ".staticbolt.ts"]
}

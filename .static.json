{
  "ignore": ["dist/**"],

  "build": {
    "minify": true,
    "cleanOutDir": true,
    "analyzeOutput": {
      "enabled": true,
      "deleteUnused": true,
      "exclude": ["robots.txt", "manifest.json"]
    },
    "copyAssets": {
      "exclude": ["manifest.json"]
    },
    "convertImages": {
      "enabled": true,
      "quality": 100,
      "preset": "default"
    }
  },

  "generate": {
    "robotsTxt": [
      {
        "userAgent": "*",
        "allow": ["/"],
        "disallow": ["/nobot/"]
      }
    ]
  }
}

{
  "root": ".",
  "pagesDir": "pages",
  "jsx": "none",
  "ignorePatterns": ["dist/**", "**/*.part.html", "sources/components/**/*.{md,html-data.json}"],
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "not op_mini all"
  ],

  "dev": {
    "host": "0.0.0.0",
    "port": "3000",
    "entry": "/"
  },

  "build": {
    "outDir": "dist",
    "minify": true,
    "cleanOutDir": true,
    "removeUnusedFiles": true,
    "nodeModulesOutDir": "sources/packages",
    "webP": {
      "enabled": true,
      "quality": 100,
      "preset": "default"
    }
  },

  "generate": {
    "serviceWorker": {
      "enabled": false
    },
    "robotsTxt": [
      {
        "userAgent": "*",
        "allow": ["/"],
        "disallow": ["/nobot/"]
      }
    ]
  },

  "packages": {},

  "babelPlugins": [],
  "postcssPlugins": []
}
